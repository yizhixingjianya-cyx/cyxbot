# ============================================================
# 机器人 .env 配置模板 (NoneBot2 + OneBot V11)
# 用法: 复制本文件为 .env 后按需填写
#   Linux:  cp .env.example .env
#   Windows: copy .env.example .env
# 生效位置: 与 bot.py 同目录 (项目根目录)
#
# 配置优先级: .env 环境变量 > config.yaml 默认值
# 注意: bot.py 中 nonebot.init() 的参数全部来自 config.yaml,
#       会覆盖 .env 中同名的 NoneBot 核心配置项
# ============================================================

# ---------------- NoneBot 核心配置 (以 config.yaml 为准, 仅供参考) ----------------
# 本项目由 config.yaml 的 bot.* 段驱动, 以下项默认被覆盖, 无需填写
# DRIVER=~fastapi+~httpx+~websockets
# HOST=127.0.0.1
# PORT=8080
# SUPERUSERS=["1234567890","9876543210"]
# COMMAND_START=["!","/","?","#"]
# LOG_LEVEL=INFO

# ---------------- simple/id 插件 (goqbot ID 绑定 / 头像替换) ----------------
# ★ goqbot(QQ官方) 下用户的 user_id 是 openid, 无法直接获取头像。
#   用户发送「绑定 <QQ号>」绑定后, 其消息 user_id 会被替换为绑定 QQ,
#   头像获取 (q1.qlogo.cn) 也会使用绑定 QQ 号。未绑定则取不到头像。
# 可选: 指定拦截 ID 替换的机器人 (留空表示全部机器人)
# USERID_INTERCEPTOR_BOTS=

# ---------------- ftv 插件 (FurtvTV 福瑞TV) ----------------
# ★ 必填: 动态令牌认证, 缺失则 ftv 功能不可用
FTV_APP_ID=your_ftv_app_id
FTV_CLIENT_SECRET=your_ftv_client_secret
# 可选: API 地址 / 缓存配置
FTV_BASE_URL=https://open-global.vdsentnet.com
# FTV_USE_LOCALSTORE=true
# FTV_NO_CACHE=false
#
# ---- 图文合并 (把图片 + 文字/按钮 放进同一条消息) ----
# 背景: QQ 官方 markdown 里的图片必须是公网 URL (平台会去下载转存)。
#       ftv 的档案/统计图是本机画出来的, 源站没有, 所以要先落进本机静态目录,
#       再由「图床静态服务」对外提供 (util/static_server.py, 只读, 默认监听 11451)。
#       「每日鉴毛」的图在源站上但链接带签名会过期, 所以也要先下载转存进来
#       (见 src/plugins/pyfurbot/command/furry_will.py)。
# 图床按用途分两个子目录, 启动时自动建好 (util/image_host.py::init_hosting):
#   ftv/tmp/    临时图: ftv 档案图/统计图、awmc 表情包, 超过 24 小时没人取就删掉
#   ftv/keep/   持久图: 每日鉴毛转存的卡片, 永久保留, 不参与回收
# "有人取" = 图床服务被请求过一次 (每次回图都会刷新 mtime), 所以常看的图不会被误删。
# 到底「什么时候落的 / 最近什么时候被用过」记在 SQLite 索引里 (util/image_index.py,
# 默认 src/data/image_index.db): 发布图片时记一笔、被取图时刷一次 used_at, 回收时
# 直接查「超过 TTL 没被用过」的行 —— 不靠文件 mtime (备份/rsync/cp 都会把它刷成"现在",
# 判断会失真), mtime 只在索引里没这张图时作兜底。
# 变量名有两套, 填一套即可 (通用名优先): IMAGE_HOST_URL / FTV_IMAGE_HOST
# ★ IMAGE_HOST_URL 必须是「公网能访问、且指向本机 11451 图床服务」的地址。
#   共享 NAT 场景直接写 IP:端口(自动补 http://); 服务器在 NAT 后面时填映射后的公网端口。
IMAGE_HOST_URL=1.2.3.4:11451
# 图床服务监听端口 / 监听地址 (默认 0.0.0.0, 端口直通必须全网卡)
# IMAGE_HOST_PORT=11451
# IMAGE_HOST_BIND=0.0.0.0
# 临时图保留小时数, 默认 24; 置 0 = 临时图也不回收 (磁盘会一直涨, 不建议)
# IMAGE_TTL_HOURS=24
# 图床索引库位置, 默认 src/data/image_index.db (相对项目根); 一般不用改
# IMAGE_INDEX_DB=src/data/image_index.db
# 不设置 / 注释掉 IMAGE_HOST_URL = 关闭「图+按钮」合并 (档案/统计图会退成「图片一条 + 文字按钮一条」)。
# 也支持 FTV_IMAGE_HOST=<公网地址:端口>, 与上面等价。
# IMAGE_HOSTING=false               # 置 false 可整体关闭图片托管 (FTV_IMAGE_HOSTING 同义)
# IMAGE_HOST_SERVE=false            # 只写图不起服务 (改用 nginx 等外部 Web 服务器时)
# IMAGE_HOST_DIR=/var/www/html/ftv  # 自定义静态目录 (FTV_IMAGE_DIR 同义, 一般不用改)
# IMAGE_HOST_PREFIX=ftv             # URL 路径前缀 (FTV_IMAGE_PREFIX 同义, 一般不用改)

# ---------------- guanli 管理面板 (Web 后台) ----------------
# 面板实现在 util/guanli_panel（FastAPI + uvicorn，独立线程），端口直通对外，不需要 nginx：
#   https://1.2.3.4:28788/      （面板自己监听 0.0.0.0:28788，默认开自签证书）
# 群内发送「获取配置秘钥」（超管）或「管理面板」可拿到地址。
#
# 登录方式（三条渠道并存，任何一条可用就不会把自己锁在门外）：
#   1) 账号密码：面板自建账号，在面板「面板账号」里增删改，角色分 admin / viewer
#   2) OIDC     ：统一身份认证（授权码 + PKCE），整页跳转到 IdP 再跳回来
#   3) 访问口令 ：应急兜底，等价于旧的单口令登录
#
# ★ 端口直通 = 面板直接摆在公网上，所以默认就按「不安全网络」来防：
#   默认 HTTPS（自签证书）、口令至少 12 位且要两类字符、同一来源连续失败 8 次锁 10 分钟。
#
# 面板监听端口（默认 28788）
GUANLI_PORT=28788
# 面板监听地址。端口直通对外，必须绑 0.0.0.0；绑 127.0.0.1 时公网会「拒绝连接」
GUANLI_HOST=0.0.0.0
# 回给用户看的完整面板地址（也是 OIDC 回调地址的拼接依据：<base>/api/oidc/callback）
# 端口直通必须带端口；开了 HTTPS 就写 https://，否则会跳到没人监听的明文端口
GUANLI_BASE_URL=https://1.2.3.4:28788/
# 会话有效期（小时），默认 168 = 7 天
# GUANLI_SESSION_HOURS=168
#
# --- HTTPS：默认自签证书（首次访问浏览器提示「证书不受信任」，点「继续访问」即可） ---
# GUANLI_SSL=true               # false / 0 / off = 关闭 HTTPS 回落明文（不推荐）
# GUANLI_SSL_AUTO=true          # 自签证书自动生成，存放于 src/data/guanli/tls/
# GUANLI_SSL_CERTFILE=          # 想换正式证书就填证书 / 私钥（两者成对提供，配了优先用）
# GUANLI_SSL_KEYFILE=
#
# --- 口令强度 ---
# GUANLI_PASSWORD_MIN=12        # 面板账号口令最小长度，默认 12（下限 8）
#
# --- 渠道三：应急访问口令（旧渠道，保留兼容） ---
# 不填则首次启动随机生成并写入 src/data/guanli/panel.json，口令会打进日志
# GUANLI_TOKEN=
#
# --- 渠道一：初始管理员账号（仅首次启动、账号表为空时创建） ---
# 用户名默认 admin；密码不填则随机生成并打进日志，登录后请立刻在面板里改掉
# ★ 建议这里就填一个强口令（≥12 位、含大小写/数字/符号）；填弱口令会建号但打警告
# GUANLI_ADMIN_USER=admin
# GUANLI_ADMIN_PASSWORD=
#
# --- 渠道二：OIDC 统一身份认证（填 ISSUER + CLIENT_ID 即启用） ---
# 兼容 Keycloak / Authentik / Authelia / Auth0 / 飞书 Lark / 阿里云 IDaaS 等
# 只要暴露 /.well-known/openid-configuration 的服务端
# GUANLI_OIDC_ISSUER=https://sso.example.com/realms/main
# GUANLI_OIDC_CLIENT_ID=bot-panel
# GUANLI_OIDC_CLIENT_SECRET=            # 公共客户端（PKCE）可留空
# GUANLI_OIDC_REDIRECT_URI=             # 留空 = <GUANLI_BASE_URL>/api/oidc/callback
# GUANLI_OIDC_SCOPES=openid profile email
# GUANLI_OIDC_NAME=统一身份认证          # 登录页按钮上的名字
# GUANLI_OIDC_AUTO_CREATE=true          # 首次登录自动建号；false = 必须先在面板建好同名账号
# GUANLI_OIDC_DEFAULT_ROLE=admin        # 自动建号时的角色：admin / viewer
# ★ 下面两项留空 = 不限制，该 IdP 下任何用户都能进面板，强烈建议至少配一项
# GUANLI_OIDC_ALLOWED_EMAILS=a@x.com,b@x.com
# GUANLI_OIDC_ALLOWED_DOMAINS=example.com
# GUANLI_OIDC_REQUIRE_VERIFIED_EMAIL=false

# ---------------- pyfurbot / dangan (福瑞控制台 API) ----------------
# 代码内已带默认凭证, 需要覆盖时才填写 (与 ftv 插件的 FTV_APP_ID 是两套)
# APPID=your_appid
# APPKEY=your_appkey
# FTVBASEURL=https://api-vdp.hydun.com

# ---------------- pyfurbot / furry_will (福瑞遗嘱) ----------------
# ---------------- mcsm 插件 (MCSManager 面板节点状态) ----------------
# 功能: 发送「节点状态 / mcsm / 节点」即可查看面板所有节点(守护进程)的在线状态
# API Key 获取: 打开面板 -> 用户管理 -> API密钥 -> 生成并复制
# 注: 以下两行必填(去掉行首 # 并填上实际值)
MCSM_BASE_URL=http://127.0.0.1:23333
MCSM_API_KEY=your_mcsm_api_key
# 查询命令可用级别: member / admin / owner / super (默认 super, 仅超级用户可用)
# MCSM_COMMAND_LEVEL=super
# 请求面板超时(秒)
# MCSM_REQUEST_TIMEOUT=10
# 每日鉴毛(Furry Will) API 凭证，与 config.yaml 中 furry_will 段等价，需要覆盖时才填写
# FURRY_WILL_BASE_URL=https://mrjm.fur-bot.com
# FURRY_WILL_JWT_SECRET=your_jwt_secret
# FURRY_WILL_JWT_QQ=1234567890

# ---------------- pyfurbot / furpic (福瑞图库) ----------------
# FURRY_API_BASE_URL=https://furry.axzt.top
# FURRY_API_FORMAT=json
# FURRY_API_REDIRECT=1
# FURRY_API_MODE=large
# FURRY_COMMAND=.furry
# FURRY_REQUEST_TIMEOUT=30

# ---------------- lezi / awmc (随机表情包) ----------------
# 自定义表情包素材目录, 默认取插件内置 image 目录
# RANDOM_MEME_FOLDER=

# ---------------- lezi / daypass (每日密码) ----------------
# DJ_PASSWORD_API_URL=https://i.elaina.vin/api/%E4%B8%89%E8%A7%92%E6%B4%B2/%E5%AF%86%E7%A0%81/

# ---------------- achievements (成就插件) ----------------
# ACHIEVEMENTS_NOTIFICATION=true
# ACHIEVEMENTS_NOTIFICATION_TEMPLATE=🎉 恭喜你获得成就：{name}\n📝 描述：{description}\n🏆 成就ID：{id}
# ACHIEVEMENTS_AUTO_SAVE_INTERVAL=60
# ACHIEVEMENTS_ALLOW_DUPLICATE_REGISTRATION=false
# ACHIEVEMENTS_IMAGE_ENABLED=true
# ACHIEVEMENTS_IMAGE_BACKGROUND=#2c3e50
# ACHIEVEMENTS_IMAGE_TEXT_COLOR=#ffffff
# ACHIEVEMENTS_IMAGE_TITLE_COLOR=#f1c40f

# ---------------- hoc (Markdown 文档搜索) ----------------
# MD_SEARCH_DIRECTORIES=["docs"]
# MD_CACHE_REFRESH_INTERVAL=300

# ---------------- image_reader (图片阅读) ----------------
# IMAGE_READER_MAX_PAGES=1000
# IMAGE_READER_DB_FILE=data/image_reader.db
# IMAGE_READER_BASE_DIR=image

# ---------------- nonebot_plugin_memes (表情包生成) ----------------
# 一般保持默认即可
# MEMES_COMMAND_PREFIXES=
# MEMES_DISABLED_LIST=[]
# MEMES_CHECK_RESOURCES_ON_STARTUP=true
# MEMES_USE_SENDER_WHEN_NO_IMAGE=false
# MEMES_USE_DEFAULT_WHEN_NO_TEXT=false
# MEMES_RANDOM_MEME_SHOW_INFO=true
