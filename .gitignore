*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── 运行时缓存 / 日志 / 状态 ──
logs/
states/
src/plugins/ftv/cache/
data/dj_password_cache.json

# ── 体积过大、需另行获取的素材（舞萌封面与评级图） ──
data/static/mai/

# ── 图床落盘目录（运行时生成） ──
data/static/ftv/

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 虚拟环境 ──
.venv/
venv/
botenv/

# ── 编辑器 / 系统 ──
